POSTGRES_DB=routelog
POSTGRES_USER=routelog
POSTGRES_PASSWORD=routelog
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
# Prefer this for Supabase / Vercel (overrides POSTGRES_* when set):
# DATABASE_URL=postgresql://postgres.[ref]:[PASSWORD]@aws-0-....pooler.supabase.com:6543/postgres?sslmode=require
DJANGO_DEBUG=true
DJANGO_SECRET_KEY=change-me-in-production
ALLOWED_HOSTS=localhost,127.0.0.1,.vercel.app
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
ORS_API_KEY=
CELERY_TASK_ALWAYS_EAGER=true
# Frontend (set in Vercel project env for frontend):
# VITE_API_BASE=https://your-api.vercel.app/api/v1
